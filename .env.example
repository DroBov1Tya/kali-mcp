VERSION=0.0.1
PLATFORM=linux/arm64

# ── VPN / Kill-switch ─────────────────────────────────────────────────────────
VPN_IF=utun0
VPN_GATEWAY=
KILL_SWITCH=1

# ── Paths ─────────────────────────────────────────────────────────────────────
KALI_WORKSPACE=./workspace

# ── MCP server ────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=
KALI_CONTAINER=kali-mcp
KALI_EXEC_TIMEOUT=120
MCP_PORT=8080
KALI_PROXY=
