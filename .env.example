VERSION=0.1.0
PLATFORM=linux/arm64

# ── SOCKS5 gateway ────────────────────────────────────────────────────────────
# KILL_SWITCH=0 is rejected. Policy is enforced outside the Kali container.
KILL_SWITCH=1
PROXY_HOST=host.docker.internal
PROXY_PORT=7897
DNS_UPSTREAM=1.1.1.1

# ── Paths ─────────────────────────────────────────────────────────────────────
KALI_WORKSPACE=./workspace

# ── MCP server ────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=
KALI_CONTAINER=kali-mcp
KALI_EXEC_TIMEOUT=120
MCP_PORT=8172
KALI_PROXY=
